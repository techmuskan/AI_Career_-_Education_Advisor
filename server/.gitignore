npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

# Editor-specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS-generated files
.DS_Store
Thumbs.db

# Optional: Build or distribution directories (if using TypeScript/Babel)
dist/
build/
